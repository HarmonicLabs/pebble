// ===========================================================================
//  Linear Vesting — property tests
// ===========================================================================
//
//  Exercises the vesting math from `index.pebble` with the built-in test
//  framework (`pebble test`): unit tests pin the boundary behaviour, and
//  property tests check the clamp and monotonicity over fuzzed inputs.
//
//  `vestedAt` mirrors the `vested` computation inside the `claim` handler
//  (same expression, same truncating division).

function vestedAt( txEarliest: int, start: int, end: int, total: int ): int {
    const duration = end - start;
    const elapsed = txEarliest - start;
    return elapsed <= 0 ? 0
        : ( elapsed >= duration ? total
            : ( total * elapsed ) / duration );
}

// ---- unit tests: boundaries ----------------------------------------------

test nothing_vested_before_start() {
    assert vestedAt( 999, 1000, 2000, 1000000 ) == 0 else "must be 0 before start";
    assert vestedAt( 1000, 1000, 2000, 1000000 ) == 0 else "must be 0 AT start";
}

test everything_vested_after_end() {
    assert vestedAt( 2000, 1000, 2000, 1000000 ) == 1000000 else "must be total at end";
    assert vestedAt( 99999, 1000, 2000, 1000000 ) == 1000000 else "must stay total after end";
}

test halfway_vests_half() {
    assert vestedAt( 1500, 1000, 2000, 1000000 ) == 500000 else "linear at midpoint";
}

test division_rounds_down_in_favour_of_contract() {
    // 1/3 of 100 lovelace: 33.33... truncates to 33
    assert vestedAt( 1001, 1000, 1003, 100 ) == 33 else "must truncate";
}

// ---- property tests: full-range fuzzed time ------------------------------

test vested_is_clamped( t: int ) {
    const v = vestedAt( t, 1000, 2000, 1000000 );
    assert v >= 0 else "never negative";
    assert v <= 1000000 else "never exceeds total";
}

test vested_is_monotone( t: int via ( seed: int ) => seed % 3000 ) {
    const a = vestedAt( t, 1000, 2000, 1000000 );
    const b = vestedAt( t + 1, 1000, 2000, 1000000 );
    assert b >= a else "vesting must never decrease over time";
}

test remaining_claim_is_exact_at_end( claimed: int via ( seed: int ) => seed % 1000000 ) {
    // after `end`, the beneficiary can always claim exactly total - claimed
    const v = vestedAt( 2000, 1000, 2000, 1000000 );
    assert v - claimed == 1000000 - claimed else "final claim must be exact";
}
